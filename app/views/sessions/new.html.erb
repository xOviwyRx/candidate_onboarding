<% content_for :title, "Sign in" %>

<h1>Sign in</h1>

<%= form_with url: session_path, method: :post do |form| %>
  <div>
    <%= form.label :email %>
    <%= form.email_field :email, autofocus: true, autocomplete: "username" %>
  </div>

  <div>
    <%= form.label :password %>
    <%= form.password_field :password, autocomplete: "current-password" %>
  </div>

  <%= form.submit "Sign in" %>
<% end %>
