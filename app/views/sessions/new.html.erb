<% content_for :title, "Sign in" %>

<h1 class="mb-6 text-2xl font-semibold">Sign in</h1>

<%= form_with url: session_path, method: :post, class: "card space-y-4" do |form| %>
  <div>
    <%= form.label :email, class: "field-label" %>
    <%= form.email_field :email, autofocus: true, autocomplete: "username", class: "field" %>
  </div>

  <div>
    <%= form.label :password, class: "field-label" %>
    <%= form.password_field :password, autocomplete: "current-password", class: "field" %>
  </div>

  <%= form.submit "Sign in", class: "btn" %>
<% end %>
