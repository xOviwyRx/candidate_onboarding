<% content_for :title, "Your profile" %>

<h1>Your profile</h1>

<dl>
  <dt>Name</dt>
  <dd><%= "#{@candidate_profile.first_name} #{@candidate_profile.last_name}" %></dd>

  <dt>Email</dt>
  <dd><%= @candidate_profile.email %></dd>

  <dt>Phone number</dt>
  <dd><%= @candidate_profile.phone_number %></dd>

  <dt>City</dt>
  <dd><%= [ @candidate_profile.city, @candidate_profile.country ].compact_blank.join(", ") %></dd>

  <dt>Job function</dt>
  <dd><%= @candidate_profile.job_function.humanize %></dd>

  <dt>Search status</dt>
  <dd><%= @candidate_profile.search_status.humanize %></dd>

  <dt>Preferred regions</dt>
  <dd><%= @candidate_profile.preferred_regions.map(&:humanize).to_sentence %></dd>

  <dt>Maximum travel time</dt>
  <dd><%= @candidate_profile.max_travel_time %> minutes</dd>

  <dt>Employment types</dt>
  <dd><%= @candidate_profile.employment_types.map(&:humanize).to_sentence %></dd>

  <dt>Years of experience</dt>
  <dd><%= @candidate_profile.years_of_experience %></dd>

  <dt>Available working days</dt>
  <dd><%= @candidate_profile.available_working_days.map(&:humanize).to_sentence %></dd>

  <dt>Available from</dt>
  <dd><%= l @candidate_profile.available_from, format: :long %></dd>
</dl>

<% if @candidate_profile.professional_summary.present? %>
  <h2>Professional summary</h2>
  <p><%= @candidate_profile.professional_summary %></p>
<% end %>
