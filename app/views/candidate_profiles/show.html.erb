<% content_for :title, "Your profile" %>

<h1 class="mb-6 text-2xl font-semibold">Your profile</h1>

<div class="card">
  <dl class="grid grid-cols-3 gap-y-3 text-sm">
    <dt class="font-medium text-gray-500">Name</dt>
    <dd class="col-span-2"><%= "#{@candidate_profile.first_name} #{@candidate_profile.last_name}" %></dd>

    <dt class="font-medium text-gray-500">Email</dt>
    <dd class="col-span-2"><%= @candidate_profile.email %></dd>

    <dt class="font-medium text-gray-500">Phone number</dt>
    <dd class="col-span-2"><%= @candidate_profile.phone_number %></dd>

    <dt class="font-medium text-gray-500">City</dt>
    <dd class="col-span-2"><%= [ @candidate_profile.city, @candidate_profile.country ].compact_blank.join(", ") %></dd>

    <dt class="font-medium text-gray-500">Job function</dt>
    <dd class="col-span-2"><%= @candidate_profile.job_function.humanize %></dd>

    <dt class="font-medium text-gray-500">Search status</dt>
    <dd class="col-span-2"><%= @candidate_profile.search_status.humanize %></dd>

    <dt class="font-medium text-gray-500">Preferred regions</dt>
    <dd class="col-span-2"><%= @candidate_profile.preferred_regions.map(&:humanize).to_sentence %></dd>

    <dt class="font-medium text-gray-500">Maximum travel time</dt>
    <dd class="col-span-2"><%= @candidate_profile.max_travel_time %> minutes</dd>

    <dt class="font-medium text-gray-500">Employment types</dt>
    <dd class="col-span-2"><%= @candidate_profile.employment_types.map(&:humanize).to_sentence %></dd>

    <% if @candidate_profile.desired_gross_salary.present? %>
      <dt class="font-medium text-gray-500">Desired gross salary</dt>
      <dd class="col-span-2"><%= number_to_currency(@candidate_profile.desired_gross_salary, unit: "€") %> per month</dd>
    <% end %>

    <% if @candidate_profile.desired_percentage.present? %>
      <dt class="font-medium text-gray-500">Desired percentage</dt>
      <dd class="col-span-2"><%= @candidate_profile.desired_percentage %>%</dd>
    <% end %>

    <% if @candidate_profile.average_daily_revenue.present? %>
      <dt class="font-medium text-gray-500">Average daily revenue</dt>
      <dd class="col-span-2"><%= number_to_currency(@candidate_profile.average_daily_revenue, unit: "€") %></dd>
    <% end %>

    <% if @candidate_profile.big_registration_status.present? %>
      <dt class="font-medium text-gray-500">BIG registration</dt>
      <dd class="col-span-2">
        <%= [ @candidate_profile.big_registration_status.humanize,
              @candidate_profile.big_number ].compact_blank.join(" · ") %>
      </dd>
    <% end %>

    <dt class="font-medium text-gray-500">Years of experience</dt>
    <dd class="col-span-2"><%= @candidate_profile.years_of_experience %></dd>

    <dt class="font-medium text-gray-500">Available working days</dt>
    <dd class="col-span-2"><%= @candidate_profile.available_working_days.map(&:humanize).to_sentence %></dd>

    <dt class="font-medium text-gray-500">Available from</dt>
    <dd class="col-span-2"><%= l @candidate_profile.available_from, format: :long %></dd>
  </dl>

  <% if @candidate_profile.candidate_languages.any? %>
    <div class="mt-6 border-t border-gray-200 pt-6">
      <h2 class="mb-3 text-sm font-medium text-gray-500">Languages</h2>

      <ul class="space-y-1 text-sm">
        <% @candidate_profile.candidate_languages.includes(:language).each do |candidate_language| %>
          <li>
            <%= [ candidate_language.language.name,
                  CandidateLanguage::LEVEL_LABELS[candidate_language.level] ].compact_blank.join(" · ") %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if @candidate_profile.skills.any? %>
    <div class="mt-6 border-t border-gray-200 pt-6">
      <h2 class="mb-3 text-sm font-medium text-gray-500">Skills</h2>
      <p class="text-sm text-gray-700"><%= @candidate_profile.skills.order(:name).pluck(:name).to_sentence %></p>
    </div>
  <% end %>

  <% if @candidate_profile.educations.any? %>
    <div class="mt-6 border-t border-gray-200 pt-6">
      <h2 class="mb-3 text-sm font-medium text-gray-500">Education</h2>

      <ul class="space-y-3 text-sm">
        <% @candidate_profile.educations.each do |education| %>
          <li>
            <p class="font-medium"><%= education.study %></p>
            <p class="text-gray-600">
              <%= [ education.institution, education.location,
                    Education::LEVEL_LABELS[education.level] ].compact_blank.join(" · ") %>
            </p>
            <% if education.start_date || education.end_date %>
              <p class="text-gray-500">
                <%= [ education.start_date&.year, education.end_date&.year ].compact.join(" – ") %>
              </p>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if @candidate_profile.work_experiences.any? %>
    <div class="mt-6 border-t border-gray-200 pt-6">
      <h2 class="mb-3 text-sm font-medium text-gray-500">Work experience</h2>

      <ul class="space-y-3 text-sm">
        <% @candidate_profile.work_experiences.each do |work_experience| %>
          <li>
            <p class="font-medium"><%= work_experience.job_title %></p>
            <p class="text-gray-600"><%= work_experience.company_name %></p>
            <% if work_experience.start_date || work_experience.end_date || work_experience.current_job? %>
              <p class="text-gray-500">
                <%= [ work_experience.start_date&.year,
                      work_experience.current_job? ? "Present" : work_experience.end_date&.year ].compact.join(" – ") %>
              </p>
            <% end %>
            <% if work_experience.responsibilities.present? %>
              <p class="mt-1 text-gray-700"><%= work_experience.responsibilities %></p>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if @candidate_profile.professional_summary.present? %>
    <div class="mt-6 border-t border-gray-200 pt-6">
      <h2 class="mb-2 text-sm font-medium text-gray-500">Professional summary</h2>
      <p class="text-sm text-gray-700"><%= @candidate_profile.professional_summary %></p>
    </div>
  <% end %>
</div>
