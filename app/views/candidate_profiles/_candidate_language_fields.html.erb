<div class="rounded-md border border-gray-200 p-4" data-nested-form-row>
  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= form.label :language_id, "Language", class: "field-label" %>
      <%= form.collection_select :language_id, Language.order(:name), :id, :name,
                                 { include_blank: "Please choose" }, class: "field" %>
    </div>

    <div>
      <%= form.label :level, class: "field-label" %>
      <%= form.select :level, CandidateLanguage::LEVEL_LABELS.map(&:reverse),
                      { include_blank: "Please choose" }, class: "field" %>
    </div>
  </div>

  <div class="mt-4 flex justify-end">
    <button type="button" class="text-sm text-red-600 hover:underline"
            data-action="nested-form#remove">Remove</button>
  </div>
</div>
