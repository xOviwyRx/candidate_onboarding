<% content_for :title, "Complete your profile" %>

<h1 class="mb-2 text-2xl font-semibold">Complete your profile</h1>

<p class="mb-6 text-sm text-gray-600">
  We filled in what we could read from your CV. Please check it and complete the rest.
</p>

<%= form_with model: @candidate_profile, url: candidate_profile_path, class: "space-y-6",
              data: {
                controller: "conditional-fields",
                conditional_fields_big_functions_value: CandidateProfile::BIG_JOB_FUNCTIONS.to_json,
                conditional_fields_percentage_types_value: CandidateProfile::PERCENTAGE_EMPLOYMENT_TYPES.to_json
              } do |form| %>
  <%= render "shared/form_errors", model: @candidate_profile %>

  <fieldset class="card space-y-4">
    <legend class="legend">Personal details</legend>

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <%= form.label :first_name, class: "field-label" %>
        <%= form.text_field :first_name, class: "field" %>
      </div>

      <div>
        <%= form.label :last_name, class: "field-label" %>
        <%= form.text_field :last_name, class: "field" %>
      </div>
    </div>

    <div>
      <%= form.label :email, class: "field-label" %>
      <%= form.email_field :email, class: "field" %>
    </div>

    <div>
      <%= form.label :phone_number, class: "field-label" %>
      <%= form.telephone_field :phone_number, class: "field" %>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <%= form.label :city, "City / place of residence", class: "field-label" %>
        <%= form.text_field :city, class: "field" %>
      </div>

      <div>
        <%= form.label :country, class: "field-label" %>
        <%= form.text_field :country, class: "field" %>
      </div>
    </div>
  </fieldset>

  <fieldset class="card space-y-4">
    <legend class="legend">Job preferences</legend>

    <div>
      <%= form.label :job_function, "Desired job function", class: "field-label" %>
      <%= form.select :job_function,
                      CandidateProfile::JOB_FUNCTIONS.map { |value| [ value.humanize, value ] },
                      { include_blank: "Please choose" },
                      class: "field",
                      data: { conditional_fields_target: "jobFunction", action: "conditional-fields#refresh" } %>
    </div>

    <div>
      <%= form.label :search_status, class: "field-label" %>
      <%= form.select :search_status,
                      CandidateProfile::SEARCH_STATUSES.map { |value| [ value.humanize, value ] },
                      { include_blank: "Please choose" }, class: "field" %>
    </div>

    <div>
      <%= form.label :max_travel_time, "Maximum travel time (minutes)", class: "field-label" %>
      <%= form.number_field :max_travel_time, min: 0, class: "field" %>
    </div>

    <%= render "shared/check_box_group", form: form, attribute: :preferred_regions,
               collection: CandidateProfile::PREFERRED_REGIONS,
               label: "Preferred regions", columns: "sm:grid-cols-3" %>
  </fieldset>

  <fieldset class="card space-y-4">
    <legend class="legend">Employment</legend>

    <%= render "shared/check_box_group", form: form, attribute: :employment_types,
               collection: CandidateProfile::EMPLOYMENT_TYPES,
               label: "Desired employment type", columns: "sm:grid-cols-3",
               box_options: { data: { conditional_fields_target: "employmentType",
                                      action: "conditional-fields#refresh" } } %>

    <div data-conditional-fields-target="section" data-show-for="salary">
      <%= form.label :desired_gross_salary, "Desired gross salary (€ per month)", class: "field-label" %>
      <%= form.number_field :desired_gross_salary, min: 0, step: 0.01, class: "field" %>
    </div>

    <div data-conditional-fields-target="section" data-show-for="percentage">
      <%= form.label :desired_percentage, "Desired percentage (%)", class: "field-label" %>
      <%= form.number_field :desired_percentage, min: 0, max: 100, step: 0.01, class: "field" %>
    </div>

    <div data-conditional-fields-target="section" data-show-for="big" class="space-y-4">
      <div>
        <%= form.label :average_daily_revenue, "Average daily revenue (€)", class: "field-label" %>
        <%= form.number_field :average_daily_revenue, min: 0, step: 0.01, class: "field" %>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <%= form.label :big_registration_status, "BIG registration status", class: "field-label" %>
          <%= form.select :big_registration_status,
                          CandidateProfile.big_registration_statuses.keys.map { |value| [ value.humanize, value ] },
                          { include_blank: "Please choose" }, class: "field" %>
        </div>

        <div>
          <%= form.label :big_number, "BIG number", class: "field-label" %>
          <%= form.text_field :big_number, class: "field" %>
        </div>
      </div>
    </div>

    <div>
      <%= form.label :years_of_experience, "Years of dental experience", class: "field-label" %>
      <%= form.number_field :years_of_experience, min: 0, step: 0.5, class: "field" %>
    </div>
  </fieldset>

  <fieldset class="card space-y-4" data-controller="nested-form">
    <legend class="legend">Education</legend>

    <div class="space-y-4" data-nested-form-target="rows">
      <%= form.fields_for :educations do |education_form| %>
        <%= render "education_fields", form: education_form %>
      <% end %>
    </div>

    <template data-nested-form-target="template">
      <%= form.fields_for :educations, Education.new, child_index: "NEW_RECORD" do |education_form| %>
        <%= render "education_fields", form: education_form %>
      <% end %>
    </template>

    <button type="button" class="btn-secondary" data-action="nested-form#add">Add education</button>
  </fieldset>

  <fieldset class="card space-y-4" data-controller="nested-form">
    <legend class="legend">Work experience</legend>

    <div class="space-y-4" data-nested-form-target="rows">
      <%= form.fields_for :work_experiences do |work_experience_form| %>
        <%= render "work_experience_fields", form: work_experience_form %>
      <% end %>
    </div>

    <template data-nested-form-target="template">
      <%= form.fields_for :work_experiences, WorkExperience.new, child_index: "NEW_RECORD" do |work_experience_form| %>
        <%= render "work_experience_fields", form: work_experience_form %>
      <% end %>
    </template>

    <button type="button" class="btn-secondary" data-action="nested-form#add">Add job</button>
  </fieldset>

  <fieldset class="card space-y-4">
    <legend class="legend">Availability</legend>

    <%= render "shared/check_box_group", form: form, attribute: :available_working_days,
               collection: CandidateProfile::WORKING_DAYS,
               label: "Available working days", columns: "sm:grid-cols-4" %>

    <div>
      <%= form.label :available_from, class: "field-label" %>
      <%= form.date_field :available_from, class: "field" %>
    </div>
  </fieldset>

  <fieldset class="card space-y-4">
    <legend class="legend">Additional information</legend>

    <div>
      <%= form.label :professional_summary, class: "field-label" %>
      <%= form.text_area :professional_summary, rows: 4, class: "field" %>
    </div>
  </fieldset>

  <%= form.submit "Save profile", class: "btn" %>
<% end %>
