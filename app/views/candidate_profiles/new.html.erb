<% content_for :title, "Complete your profile" %>

<h1>Complete your profile</h1>

<p>We filled in what we could read from your CV. Please check it and complete the rest.</p>

<%= form_with model: @candidate_profile, url: candidate_profile_path do |form| %>
  <% if @candidate_profile.errors.any? %>
    <ul class="errors">
      <% @candidate_profile.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <fieldset>
    <legend>Personal details</legend>

    <div><%= form.label :first_name %> <%= form.text_field :first_name %></div>
    <div><%= form.label :last_name %> <%= form.text_field :last_name %></div>
    <div><%= form.label :email %> <%= form.email_field :email %></div>
    <div><%= form.label :phone_number %> <%= form.telephone_field :phone_number %></div>
    <div><%= form.label :city, "City / place of residence" %> <%= form.text_field :city %></div>
    <div><%= form.label :country %> <%= form.text_field :country %></div>
  </fieldset>

  <fieldset>
    <legend>Job preferences</legend>

    <div>
      <%= form.label :job_function, "Desired job function" %>
      <%= form.select :job_function,
                      CandidateProfile::JOB_FUNCTIONS.map { |value| [ value.humanize, value ] },
                      include_blank: "Please choose" %>
    </div>

    <div>
      <%= form.label :search_status %>
      <%= form.select :search_status,
                      CandidateProfile::SEARCH_STATUSES.map { |value| [ value.humanize, value ] },
                      include_blank: "Please choose" %>
    </div>

    <div>
      <%= form.label :max_travel_time, "Maximum travel time (minutes)" %>
      <%= form.number_field :max_travel_time, min: 0 %>
    </div>

    <fieldset>
      <legend>Preferred regions</legend>
      <%= form.collection_check_boxes :preferred_regions, CandidateProfile::PREFERRED_REGIONS,
                                      :itself, :humanize, include_hidden: false %>
    </fieldset>
  </fieldset>

  <fieldset>
    <legend>Employment</legend>

    <fieldset>
      <legend>Desired employment type</legend>
      <%= form.collection_check_boxes :employment_types, CandidateProfile::EMPLOYMENT_TYPES,
                                      :itself, :humanize, include_hidden: false %>
    </fieldset>

    <div>
      <%= form.label :years_of_experience, "Years of dental experience" %>
      <%= form.number_field :years_of_experience, min: 0, step: 0.5 %>
    </div>
  </fieldset>

  <fieldset>
    <legend>Availability</legend>

    <fieldset>
      <legend>Available working days</legend>
      <%= form.collection_check_boxes :available_working_days, CandidateProfile::WORKING_DAYS,
                                      :itself, :humanize, include_hidden: false %>
    </fieldset>

    <div><%= form.label :available_from %> <%= form.date_field :available_from %></div>
  </fieldset>

  <fieldset>
    <legend>Additional information</legend>

    <div>
      <%= form.label :professional_summary %>
      <%= form.text_area :professional_summary, rows: 4 %>
    </div>
  </fieldset>

  <%= form.submit "Save profile" %>
<% end %>
