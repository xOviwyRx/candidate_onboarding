# Copy to .env and fill in. The app reads these through dotenv-rails.

# PostgreSQL role that owns the development and test databases.
DB_USERNAME=
DB_PASSWORD=

# Optional. Maximum CV upload size in megabytes; defaults to 25.
# MAX_CV_FILE_SIZE_MB=25

# Optional. Where the onboarding notification goes; defaults to
# recruitment@example.com.
# RECRUITMENT_TEAM_EMAIL=
